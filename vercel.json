{
  "version": 2,
  "builds": [
    {
      "src": "api/mn.js",
      "use": "@vercel/node",
      "config": { "includeFiles": ["node_modules/**"] }
    },
    {
      "src": "api/mf.js",
      "use": "@vercel/node",
      "config": { "includeFiles": ["node_modules/**"] }
    },
    {
      "src": "visual/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/mn", "dest": "/api/mn.js" },
    { "src": "/api/mf", "dest": "/api/mf.js" },
    { "src": "/(.*)", "dest": "/visual/$1" }
  ]
}